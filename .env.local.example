# Connexion Postgres avec le rôle dédié registre_factures_app (voir migration
# 0048_registre_factures_avoirs.sql dans le dépôt appli-gestion) — accès
# UNIQUEMENT aux tables factures/avoirs/compteur_facture_avoir, jamais au
# reste de la base (Appli Terrain / Appli Gestion).
DATABASE_URL=postgresql://registre_factures_app:MOT_DE_PASSE@HOTE:6543/postgres

# Mot de passe unique partagé pour accéder à ce site (voir middleware.ts) —
# choisis-en un fort, communiqué à la main aux personnes autorisées.
REGISTRE_PASSWORD=CHANGE_ME

# Clé aléatoire utilisée pour signer le cookie de session (générée une fois,
# ex. `openssl rand -hex 32` ou tout générateur de chaîne aléatoire longue) —
# ne change jamais sans déconnecter tout le monde.
SESSION_SECRET=CHANGE_ME_RANDOM_LONG_STRING
